{
    "compilerOptions": {
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "types": ["./worker-configuration.d.ts"]
    },
    "include": ["src/**/*.js", "test/types/worker.ts"],
    "exclude": ["src/**/*.test.js"]
}
